# IIA Application Environment Configuration
# Copy this file to .env.local and fill in values
# NEVER commit .env.local to Git

# Development Mode
NODE_ENV=development

# Use mock authentication for local development
# Set to 'true' for npm run dev without SWA CLI
# Set to 'false' when using swa start or in Azure
VITE_USE_MOCK_AUTH=true

# API Base URL
# Local dev: /api (proxied to 7071)
# Azure: /api (handled by SWA)
VITE_API_BASE_URL=/api
